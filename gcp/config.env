# Settings for the gcp/ scripts. Any value can be overridden from the environment,
# e.g. `REGION=europe-west4 gcp/deploy.sh`.

: "${PROJECT_ID:=data-sharks-internal}"
: "${REGION:=asia-southeast1}"                 # Singapore; has Cloud Run L4 GPUs
: "${BUCKET:=${PROJECT_ID}-tech-debate-models}" # holds the Ollama model store (blobs/ + manifests/)
: "${DEBATE_PROFILE_CLOUD:=cloud}"             # which config/debate.<profile>.yaml lists the cloud models

# Stock Ollama image, pinned by digest (multi-arch index of ollama/ollama:0.40.11).
: "${OLLAMA_IMAGE:=docker.io/ollama/ollama:0.40.11@sha256:dea72d1e22270fe095b68fdf756d2b489d615643c5a2eaebbc5f569181e322d8}"
: "${CLOUD_SDK_IMAGE:=gcr.io/google.com/cloudsdktool/cloud-sdk:590.0.1-slim}"

# GPU and sizing. L4 = 24 GB VRAM: fits up to ~20B parameters at 4-bit.
# Cloud Run's minimum with an L4 is 4 CPU / 16Gi; larger models get 8 CPU / 32Gi.
: "${GPU_TYPE:=nvidia-l4}"
: "${SMALL_MAX_B:=8}"                           # models with <= this many billion params use the small tier
: "${SMALL_CPU:=4}"
: "${SMALL_MEMORY:=16Gi}"
: "${LARGE_CPU:=8}"
: "${LARGE_MEMORY:=32Gi}"

# Scaling: scale to zero when idle, never more than one instance (one GPU) per service.
# Idle GPU instances are shut down by Cloud Run after at most 10 minutes; that is not a flag.
: "${MIN_INSTANCES:=0}"
: "${MAX_INSTANCES:=1}"
: "${CONCURRENCY:=4}"
: "${REQUEST_TIMEOUT:=900}"                     # seconds; a turn on a cold 20B model can take minutes

# Direct VPC egress so Cloud Storage reads go over Private Google Access.
: "${NETWORK:=default}"
: "${SUBNET:=default}"

# Local ports for `gcloud run services proxy` (11434 stays free for a native Ollama).
: "${PROXY_PORT_PRO:=11441}"
: "${PROXY_PORT_CON:=11442}"
: "${PROXY_PORT_JUDGE:=11443}"
