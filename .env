# Defaults for a bare `docker compose up`. The Makefile overrides these per MODE.
# cpu  = Ollama + Kokoro in containers (works everywhere, slowest)
# gpu  = NVIDIA containers for Ollama + Kokoro
# host = use Ollama already running on your machine (fastest on Apple Silicon: Metal)
COMPOSE_PROFILES=cpu
OLLAMA_URL=http://ollama:11434
